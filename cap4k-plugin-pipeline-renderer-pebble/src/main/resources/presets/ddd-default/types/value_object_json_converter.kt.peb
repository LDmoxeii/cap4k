@jakarta.persistence.Converter(autoApply = false)
class {{ typeName }} : AttributeConverter<{{ type(valueObjectTypeFqn) | raw }}, String> {
    override fun convertToDatabaseColumn(attribute: {{ type(valueObjectTypeFqn) | raw }}?): String? =
        if (attribute == null) null else mapper.writeValueAsString(attribute)

    override fun convertToEntityAttribute(dbData: String?): {{ type(valueObjectTypeFqn) | raw }}? =
        dbData?.let { mapper.readValue<{{ type(valueObjectTypeFqn) | raw }}>(it) }

    companion object {
        private val mapper: ObjectMapper = ObjectMapper().findAndRegisterModules()
    }
}
