      {
        "name": "receipt",
        "type": "Receipt?",
        "defaultValue": "null"
      },
      {
        "name": "receipt.sequence",
        "type": "Long",
        "defaultValue": "0"
      },
      {
        "name": "receipt.tags",
        "type": "Set<String>",
        "defaultValue": "emptySet()"
      }
    ]
  },
