        "defaultValue": "\"before\\u000cafter\""
      },
      {
        "name": "orderId",
        "type": "com.acme.demo.domain.aggregates.order.OrderId"
      },
      {
        "name": "stage",
        "type": "com.acme.demo.domain.shared.enums.OrderStage",
        "defaultValue": "com.acme.demo.domain.shared.enums.OrderStage.NEW"
